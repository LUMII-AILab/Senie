       <lb id="Apokr1689::Prolog_02_4"/>
        <div type="Language" lang="Latvian">III. Tobijus.</div>
       <lb id="Apokr1689::Prolog_02_5"/>
        <div type="Language" lang="Latvian">IV. Sihraks.</div>
       <lb id="Apokr1689::Prolog_02_6"/>
        <div type="Language" lang="Latvian">V. Bahruks.</div>
       <lb id="Apokr1689::Prolog_02_7"/>
        <div type="Language" lang="Latvian">VI. To Makkabeëŗu Grahmatas.</div>
       <lb id="Apokr1689::Prolog_02_8"/>
        <div type="Language" lang="Latvian">VII. Gabbali pee Eſteres Grahmatas.</div>
       <lb id="Apokr1689::Prolog_02_9"/>
        <div type="Language" lang="Latvian">VIII. Gabbali pee Danijeļa Grahmatas.</div>
