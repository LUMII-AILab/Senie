    <body>
      <pb n="01"/>
      <div type="Paragraph">
       <lb id="Apokr1689::Prolog_01_1"/>
        <div type="Language" lang="Latvian">APOCRYPHA:</div>
       <lb id="Apokr1689::Prolog_01_2"/>
        <div type="Language" lang="Latvian">Tee irr</div>
       <lb id="Apokr1689::Prolog_01_3"/>
        <div type="Language" lang="Latvian">Grahmatas/</div>
       <lb id="Apokr1689::Prolog_01_4"/>
        <div type="Language" lang="Latvian">Kas teem ẜwehteem Deewa Rak-</div>
       <lb id="Apokr1689::Prolog_01_5"/>
        <div type="Language" lang="Latvian">ſteem lihdſi ne turramas/ un tomehr derrigas un</div>
       <lb id="Apokr1689::Prolog_01_6"/>
        <div type="Language" lang="Latvian">labbi laẜẜamas irraid.</div>
      </div>
      <div type="Paragraph">
       <lb id="Apokr1689::Prolog_01_7"/>
        <div type="Language" lang="Latvian">RJGA</div>
      </div>
      <div type="Paragraph">
       <lb id="Apokr1689::Prolog_01_8"/>
       <div type="Language" lang="German">Gedruckt bey Johann Georg Wilcken/ Königl.</div>
       <lb id="Apokr1689::Prolog_01_9"/>
       <div type="Language" lang="German">Buchdrucker/ Jm Jahr</div>
       <div type="Language" lang="Latin">M DC LXXXIX.</div>
      </div>
      <pb n="02"/>
      <div type="Paragraph">
       <lb id="Apokr1689::Prolog_02_1"/>
        <div type="Language" lang="Latvian">APOCRYPHA.</div>
